{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nkyoa-tray durable reception state v1",
  "type": "object",
  "required": ["version", "initial", "through", "ackPending", "pending", "resyncPending"],
  "properties": {
    "version": { "const": 1 },
    "initial": { "$ref": "#/$defs/sequence" },
    "through": { "$ref": "#/$defs/sequence" },
    "ackPending": { "type": "boolean" },
    "resyncPending": { "enum": [null, 0, 1], "description": "0 = history expired, 1 = stream changed" },
    "pending": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["items", "processed", "accepted", "suppress"],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "$ref": "nkyoa-desktop-v1.openapi.json#/components/schemas/DesktopFeedItem" }
            },
            "processed": { "type": "integer", "minimum": 0, "maximum": 99 },
            "accepted": { "type": "integer", "minimum": 0, "maximum": 2 },
            "suppress": { "type": "boolean" }
          }
        }
      ]
    }
  },
  "$defs": {
    "sequence": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$" }
  }
}
